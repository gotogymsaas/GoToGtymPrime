# Copiar a environments/azure/.env.release y completar valores reales.
# Ese archivo esta en .gitignore: nunca se versiona.

# --- Destino en Azure ---------------------------------------------------
# Sin valor por defecto a proposito: el identificador de suscripcion no se
# escribe en el repositorio.
AZURE_SUBSCRIPTION_ID=<id-de-la-suscripcion>
AZURE_RELEASE_RESOURCE_GROUP=rg-gotogym-prime
AZURE_RELEASE_WEBAPP=gotogym-prime
AZURE_RELEASE_SLOT=staging

# --- Obligatorias en produccion -------------------------------------------
# Sin DJANGO_SECRET_KEY la aplicacion NO arranca (a proposito). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<clave-larga-y-aleatoria>
DEBUG=False
ALLOWED_HOSTS=shop.gotogym.store,gotogym-prime.azurewebsites.net
CSRF_TRUSTED_ORIGINS=https://shop.gotogym.store,https://gotogym-prime.azurewebsites.net

# Direccion publica: los enlaces de los correos (recuperar contrasena, ver pedido)
# usan esta, no el dominio de la peticion.
SITIO_URL=https://shop.gotogym.store

# Ruta del administrador de Django (solo superusuarios). Conviene una no obvia.
# ADMIN_URL=gestion-xxxxxxxx/

# Base de datos (PostgreSQL). Es la unica variable de BD que deben declarar
# los entornos nuevos; settings.py la toma con prioridad sobre cualquier otra.
DATABASE_URL=postgres://usuario:password@host:5432/nombre-db

# --- HTTPS ----------------------------------------------------------------
# En produccion estas tres estan ACTIVAS por defecto; declararlas solo sirve
# para apagarlas a proposito (por ejemplo, probando un contenedor sin proxy).
#   SECURE_PROXY_SSL_HEADER=true
#   SECURE_SSL_REDIRECT=true
#   SESSION_COOKIE_SECURE=true
#   CSRF_COOKIE_SECURE=true
#
# HSTS arranca solo en la primera etapa (3600, una hora) en produccion. Es dificil
# de deshacer (el navegador deja de aceptar HTTP con el dominio durante todo el
# plazo), asi que se sube por etapas, comprobando que todo el sitio funciona por
# HTTPS en cada una:
#   1) SECURE_HSTS_SECONDS=3600        (una hora, el valor por defecto)
#   2) SECURE_HSTS_SECONDS=604800      (una semana)
#   3) SECURE_HSTS_SECONDS=31536000    (un ano)
# Con subdominios y precarga solo si TODOS los subdominios usan HTTPS:
#   SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#   SECURE_HSTS_PRELOAD=true

# --- Pagos ----------------------------------------------------------------
# "mock" (por defecto) simula los pagos. "mercadopago" cobra de verdad: solo
# despues de probar el ciclo completo en sandbox (ver docs).
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=<token>
MERCADOPAGO_WEBHOOK_SECRET=<secreto-del-webhook>
# Nunca en true en produccion: abre el panel de simulacion de pagos.
PAYMENTS_MOCK_UI_ENABLED=false

# --- Integraciones --------------------------------------------------------
ALEGRA_EMAIL=<correo-de-la-cuenta-alegra>
ALEGRA_API_TOKEN=<token>
HUBSPOT_PRIVATE_TOKEN=<token>

# --- Correo (sin EMAIL_HOST los correos salen por consola y no llegan) -------
EMAIL_HOST=<servidor-smtp>
EMAIL_PORT=587
EMAIL_HOST_USER=<usuario>
EMAIL_HOST_PASSWORD=<clave>
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=GoToGym <no-reply@gotogym.store>

# --- Monitoreo ------------------------------------------------------------
SENTRY_DSN=<dsn>
SENTRY_ENVIRONMENT=production

# --- Cache compartida (limite de tasa fiable con varios procesos) ----------
# Con DATABASE_URL y sin REDIS_URL la cache vive en una tabla de la base de
# datos (`django_cache`, la crea `migrate`): compartida entre procesos sin
# infraestructura extra. Redis es mejor si se dispone de el.
# REDIS_URL=redis://<host>:6379/0

# --- Pedidos -----------------------------------------------------------------
# Horas que un pedido puede seguir sin pagar antes de cancelarse solo (48 por
# defecto: cubre un pago en efectivo).
# ORDER_PAYMENT_WINDOW_HOURS=48

# --- Tareas en segundo plano -----------------------------------------------
# "sync" (por defecto) ejecuta en el mismo proceso. Ver gotogym/tasks.py.
TASK_BACKEND=sync

# --- Administrador inicial (solo bases nuevas) ------------------------------
# Las migraciones ya NO traen una contrasena por defecto. Si se define esta
# variable al migrar una base vacia, se crea el administrador con ella; si no,
# crearlo con `python manage.py createsuperuser`.
# GOTOGYM_ADMIN_EMAIL=<correo>
# GOTOGYM_ADMIN_USERNAME=<usuario>
# GOTOGYM_ADMIN_PASSWORD=<clave-fuerte>

# --- Heredado -------------------------------------------------------------
# Solo para entornos que todavia corran sobre MySQL (requiere mysqlclient
# aparte; no esta en requirements.txt). No usar en entornos nuevos.
# MYSQL_DATABASE=<base>
# MYSQL_USER=<usuario>
# MYSQL_PASSWORD=<clave>
# MYSQL_HOST=<host>
# MYSQL_PORT=3306

# --- Registro de errores ------------------------------------------------------
# Directorio de logs/errores.txt. En Azure, una ruta persistente.
LOG_DIR=/home/LogFiles/gotogym
