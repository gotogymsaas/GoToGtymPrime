# Copiar a environments/azure/.env.release y completar valores reales.

AZURE_SUBSCRIPTION_ID=c6015f72-55d5-4282-ba0b-f02152d798f7
AZURE_RELEASE_RESOURCE_GROUP=rg-gotogym-prime
AZURE_RELEASE_WEBAPP=gotogym-prime
AZURE_RELEASE_SLOT=staging

# App settings requeridas (produccion)
DJANGO_SECRET_KEY=replace-with-strong-secret
DEBUG=False
ALLOWED_HOSTS=gotogym-prime.azurewebsites.net
CORS_ALLOWED_ORIGINS=https://gotogym-prime.azurewebsites.net
MERCADOPAGO_ACCESS_TOKEN=replace-with-prod-token
ALEGRA_API_TOKEN=replace-with-prod-token
HUBSPOT_PRIVATE_TOKEN=replace-with-private-app-token

# Database settings requeridas por settings.py
MYSQL_DATABASE=replace-with-db-name
MYSQL_USER=replace-with-db-user
MYSQL_PASSWORD=replace-with-db-password
MYSQL_HOST=replace-with-db-host
MYSQL_PORT=3306
