# Entorno de pruebas backend (copiar a .env.test)

# Django
DJANGO_SECRET_KEY=change-me-for-tests
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de datos local para pruebas de despliegue
MYSQL_DATABASE=gotogym_bd
MYSQL_USER=gotogym_user
MYSQL_PASSWORD=
MYSQL_HOST=servergotogym.mysql.database.azure.com
MYSQL_PORT=3306

# Integraciones (usar valores de sandbox/testing)
MERCADOPAGO_ACCESS_TOKEN=replace-with-sandbox-token
ALEGRA_EMAIL=test@example.com
ALEGRA_API_TOKEN=replace-with-test-token
HUBSPOT_PRIVATE_TOKEN=replace-with-private-app-token
