# Entorno de pruebas backend (copiar a .env.test)

# Django
DJANGO_SECRET_KEY=change-me-for-tests
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Base de datos: las validaciones de backend usan settings_local/settings_test,
# que fuerzan SQLite. Si se necesita apuntar a una base real, declarar
# DATABASE_URL (PostgreSQL); sin ella, settings.py cae a un SQLite local.
# DATABASE_URL=postgres://usuario:password@host:5432/nombre-db

# Integraciones (usar valores de sandbox/testing)
MERCADOPAGO_ACCESS_TOKEN=replace-with-sandbox-token
ALEGRA_EMAIL=test@example.com
ALEGRA_API_TOKEN=replace-with-test-token
