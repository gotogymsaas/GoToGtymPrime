# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Django stuff
*.sqlite3
*.log

# Registro de errores de la aplicacion (logs/errores.txt y sus rotaciones)
logs/

# Node modules
node_modules/

# Environment variables
.env
environments/**/.env.test
environments/azure/.env.release

# Local test virtualenv
.venv-backend-test/
.venv

# Build
build/

# Salida de collectstatic: se regenera en cada despliegue y con el hash de
# contenido son cientos de copias del mismo archivo.
staticfiles/

# Artefactos locales de las herramientas de calidad (ruff/mypy no dejan
# cache persistente relevante para versionar; coverage si, y no debe).
.coverage
.mypy_cache/
.ruff_cache/
htmlcov/

# Archivos temporales de trabajo, no forman parte del proyecto
Temp/

# Material de marca subido por el equipo (contenido de la operacion, no del codigo)
gotogym/recursos_afiliados/
