# Environment variables for GoToGymPrime
HUBSPOT_PRIVATE_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# "mock" (simulado) o "mercadopago". SITIO_URL debe ser la URL publica del sitio:
# con https Mercado Pago puede avisar al webhook y volver solo a la tienda.
PAYMENT_PROVIDER=mock
SITIO_URL=http://127.0.0.1:8000
# Clave secreta del webhook (panel de Mercado Pago > Webhooks > Clave secreta).
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
ALEGRA_EMAIL=
# También se acepta ALEGRA_TOKEN; si están las dos, manda ALEGRA_API_TOKEN.
ALEGRA_API_TOKEN=
# Facturación electrónica (apagada). Ver docs/FACTURACION_ALEGRA.md.
ALEGRA_FACTURACION_ACTIVA=false
ALEGRA_EMITIR_ELECTRONICA=false
ALEGRA_NUMBER_TEMPLATE_ID=
ALEGRA_IVA_TAX_ID=
ALEGRA_IVA_PORCENTAJE=19
ALEGRA_PRECIOS_INCLUYEN_IVA=true
ALEGRA_MEDIO_DE_PAGO=INSTRUMENT_NOT_DEFINED
ALEGRA_CONSUMIDOR_FINAL_ID=
ALEGRA_ITEM_GENERICO_ID=
ALEGRA_FACTURAR_DESDE=
