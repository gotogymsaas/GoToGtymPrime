# Environment variables for GoToGymPrime
HUBSPOT_PRIVATE_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# "mock" (simulado) o "mercadopago". SITIO_URL debe ser la URL publica del sitio:
# con https Mercado Pago puede avisar al webhook y volver solo a la tienda.
PAYMENT_PROVIDER=mock
SITIO_URL=http://127.0.0.1:8000
# Clave secreta del webhook (panel de Mercado Pago > Webhooks > Clave secreta).
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
ALEGRA_EMAIL=
ALEGRA_TOKEN=
